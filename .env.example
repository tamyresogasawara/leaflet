# Selfhost single-user mode: provide keys via env vars.
# Hosted demo: leave these UNSET — keys come from the user's browser per request.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# "demo" enables the demo banner + rate limiter. "selfhost" hides the banner.
NEXT_PUBLIC_DEPLOYMENT_MODE=selfhost

# Fixture vs live engines. Set to "live" to call real provider APIs.
ENGINE_MODE=fixture

# Optional model overrides. Defaults are the cheapest/fastest reasonable models;
# self-hosters can opt up to a more capable model at their own cost.
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-haiku-4-5
# MAX_TOKENS=2000

# Upstash Redis credentials — required ONLY when NEXT_PUBLIC_DEPLOYMENT_MODE=demo
# so the rate limiter has somewhere to count. In selfhost mode the limiter is
# a no-op and these can stay blank.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
